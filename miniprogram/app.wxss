/* ============ 拾光小程序 · 全局样式与设计变量 ============ */
page {
  --bg: #f5f5f7;
  --card: #ffffff;
  --card2: #f5f5f7;
  --text: #1d1d1f;
  --sub: #6e6e73;
  --border: rgba(0, 0, 0, 0.08);
  --blue: #0071e3;
  --blue-soft: rgba(0, 113, 227, 0.1);
  --danger: #e30000;
  --shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.05);
  --nav: rgba(255, 255, 255, 0.86);
  background: var(--bg);
  color: var(--text);
  font-size: 30rpx;
  line-height: 1.6;
}
@media (prefers-color-scheme: dark) {
  page {
    --bg: #000000;
    --card: #1c1c1e;
    --card2: #2c2c2e;
    --text: #f5f5f7;
    --sub: #a1a1a6;
    --border: rgba(255, 255, 255, 0.12);
    --blue: #2997ff;
    --blue-soft: rgba(41, 151, 255, 0.16);
    --danger: #ff453a;
    --shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.4);
    --nav: rgba(18, 18, 20, 0.86);
  }
}
/* 手动选择的主题（覆盖系统） */
.t-light {
  --bg: #f5f5f7;
  --card: #ffffff;
  --card2: #f5f5f7;
  --text: #1d1d1f;
  --sub: #6e6e73;
  --border: rgba(0, 0, 0, 0.08);
  --blue: #0071e3;
  --blue-soft: rgba(0, 113, 227, 0.1);
  --danger: #e30000;
  --shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.05);
  --nav: rgba(255, 255, 255, 0.86);
  background: var(--bg);
  color: var(--text);
}
.t-dark {
  --bg: #000000;
  --card: #1c1c1e;
  --card2: #2c2c2e;
  --text: #f5f5f7;
  --sub: #a1a1a6;
  --border: rgba(255, 255, 255, 0.12);
  --blue: #2997ff;
  --blue-soft: rgba(41, 151, 255, 0.16);
  --danger: #ff453a;
  --shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.4);
  --nav: rgba(18, 18, 20, 0.86);
  background: var(--bg);
  color: var(--text);
}

/* ---------- 通用 ---------- */
.card {
  background: var(--card);
  border-radius: 30rpx;
  box-shadow: var(--shadow);
  padding: 30rpx;
}
.t-dark .card, page.t-dark .card, .theme-root.t-dark .card { border: 1rpx solid rgba(255, 255, 255, 0.06); }
.section-title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
  margin: 44rpx 4rpx 22rpx;
}
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  border: 1rpx solid var(--border);
  background: var(--card);
  color: var(--text);
  font-size: 28rpx;
  font-weight: 500;
  padding: 18rpx 36rpx;
  line-height: 1.4;
}
.btn::after { border: none; }
.btn-primary { background: var(--blue); color: #ffffff; border-color: transparent; }
.btn-danger-text { color: var(--danger); }
.btn-ghost { border-color: transparent; background: var(--blue-soft); color: var(--blue); }
.chip {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: var(--card2);
  color: var(--sub);
  font-size: 24rpx;
}
.empty-tip {
  text-align: center;
  color: var(--sub);
  padding: 120rpx 40rpx;
  font-size: 28rpx;
}
.empty-tip .big { font-size: 80rpx; display: block; margin-bottom: 20rpx; }
.skeleton {
  position: relative;
  overflow: hidden;
  background: var(--card2);
  border-radius: 24rpx;
}
.skeleton::after {
  content: '';
  position: absolute;
  inset: 0;
  transform: translateX(-100%);
  background: linear-gradient(100deg, transparent 30%, rgba(255, 255, 255, 0.35) 50%, transparent 70%);
  animation: shimmer 1.4s infinite;
}
@keyframes shimmer { to { transform: translateX(100%); } }
.press { transform: scale(0.97); transition: transform 0.12s ease; }
.fade-in { animation: fadein 0.3s ease both; }
@keyframes fadein { from { opacity: 0; transform: translateY(12rpx); } }
@keyframes shake {
  10%, 90% { transform: translateX(-2rpx); }
  20%, 80% { transform: translateX(4rpx); }
  30%, 50%, 70% { transform: translateX(-8rpx); }
  40%, 60% { transform: translateX(8rpx); }
}
.shake { animation: shake 0.45s ease; }
