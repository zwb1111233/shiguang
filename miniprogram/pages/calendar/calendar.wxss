.page { padding: 24rpx 32rpx 60rpx; min-height: 100vh; box-sizing: border-box; }
.cal-card { padding: 30rpx 26rpx; }
.cal-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.cal-title { font-size: 34rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.cal-nav {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  background: var(--card2); color: var(--text);
  font-size: 40rpx; display: flex; align-items: center; justify-content: center;
}
.week-row { display: grid; grid-template-columns: repeat(7, 1fr); margin-bottom: 8rpx; }
.week-row text { text-align: center; color: var(--sub); font-size: 23rpx; }
.cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 10rpx; }
.cal-day {
  aspect-ratio: 1; border-radius: 18rpx;
  background: var(--card); border: 1rpx solid var(--border);
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6rpx;
}
.cal-day.blank { visibility: hidden; }
.cal-day .d { font-size: 28rpx; font-weight: 600; font-variant-numeric: tabular-nums; }
.cal-day.today { border-color: var(--blue); }
.cal-day.today .d { color: var(--blue); }
.cal-day.has { background: var(--blue-soft); }
.dot { width: 12rpx; height: 12rpx; border-radius: 50%; }

.legend-card { margin-top: 20rpx; }
.legend-title { font-size: 28rpx; font-weight: 700; margin-bottom: 18rpx; }
.legend-row { display: flex; flex-wrap: wrap; gap: 20rpx 28rpx; }
.legend-item { display: flex; align-items: center; gap: 10rpx; color: var(--sub); font-size: 24rpx; }
.legend-dot { width: 16rpx; height: 16rpx; border-radius: 50%; }
.legend-tip { color: var(--sub); font-size: 22rpx; margin-top: 20rpx; }
