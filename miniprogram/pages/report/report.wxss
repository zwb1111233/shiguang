.page { padding: 24rpx 32rpx 60rpx; min-height: 100vh; box-sizing: border-box; }
.year-pick {
  display: inline-block; background: var(--card); border-radius: 999rpx;
  box-shadow: var(--shadow); padding: 14rpx 32rpx;
  font-size: 29rpx; font-weight: 600; font-variant-numeric: tabular-nums;
}

.stat-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-top: 20rpx; }
.stat-card { display: flex; flex-direction: column; gap: 4rpx; padding: 28rpx 30rpx; }
.stat-card .n { font-size: 46rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.stat-card .l { color: var(--sub); font-size: 23rpx; }

.sec-card { margin-top: 20rpx; }
.sec-title { font-size: 30rpx; font-weight: 700; margin-bottom: 24rpx; }
.sec-empty { color: var(--sub); font-size: 25rpx; padding: 10rpx 0 16rpx; }

.mood-row { display: flex; align-items: center; gap: 18rpx; padding: 12rpx 0; }
.mood-lbl { width: 150rpx; font-size: 26rpx; flex: none; }
.track { flex: 1; height: 18rpx; border-radius: 10rpx; background: var(--card2); overflow: hidden; }
.fill { height: 100%; border-radius: 10rpx; }
.mood-val { width: 76rpx; text-align: right; color: var(--sub); font-size: 23rpx; font-variant-numeric: tabular-nums; }

.month-bars { display: flex; align-items: flex-end; justify-content: space-between; height: 220rpx; padding-top: 10rpx; }
.mb { display: flex; flex-direction: column; align-items: center; justify-content: flex-end; gap: 8rpx; height: 100%; flex: 1; }
.bar { width: 60%; max-width: 34rpx; border-radius: 10rpx 10rpx 6rpx 6rpx; background: linear-gradient(180deg, var(--blue), #7b61ff); min-height: 6rpx; }
.mb .m { color: var(--sub); font-size: 20rpx; }

.tags { display: flex; flex-wrap: wrap; gap: 16rpx; }
.tag-chip { color: var(--blue); }
