.page { padding: 20rpx 32rpx 60rpx; min-height: 100vh; box-sizing: border-box; }

.media-swiper { width: 100%; height: 640rpx; border-radius: 30rpx; overflow: hidden; background: #000; }
.media-item { width: 100%; height: 640rpx; }
.swiper-count {
  position: relative; margin: -56rpx auto 0; width: fit-content;
  background: rgba(0, 0, 0, 0.5); color: #fff;
  font-size: 22rpx; padding: 6rpx 22rpx; border-radius: 999rpx;
  backdrop-filter: blur(8px); z-index: 2;
}

.detail-card { margin-top: 24rpx; }
.detail-head { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20rpx; }
.detail-date { font-size: 38rpx; font-weight: 700; }
.detail-week { color: var(--sub); font-size: 24rpx; margin-top: 4rpx; }
.mood-chip {
  color: #fff; font-size: 24rpx; font-weight: 500;
  padding: 8rpx 22rpx; border-radius: 999rpx; flex: none;
}
.detail-text { font-size: 30rpx; line-height: 1.8; white-space: pre-wrap; overflow-wrap: anywhere; }
.detail-tags { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 24rpx; }
.tag-chip { color: var(--blue); }

.action-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  display: flex; gap: 18rpx; padding: 20rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: var(--nav); backdrop-filter: blur(20px);
  border-top: 1rpx solid var(--border);
}
.act-btn { flex: 1; margin: 0; }

/* 分享落地 */
.share-hero { text-align: center; padding: 60rpx 0 40rpx; }
.share-mark {
  width: 96rpx; height: 96rpx; border-radius: 28rpx; margin: 0 auto 18rpx;
  background: linear-gradient(135deg, #0090f7, #a259ff 55%, #ff5e8a);
  color: #fff; font-size: 44rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}
.share-name { color: var(--sub); font-size: 23rpx; letter-spacing: 4rpx; }
.share-title { font-size: 44rpx; font-weight: 700; margin-top: 24rpx; }
.share-note {
  margin-top: 30rpx; padding: 24rpx; border-radius: 20rpx;
  background: var(--blue-soft); color: var(--blue); font-size: 25rpx; line-height: 1.6;
}
