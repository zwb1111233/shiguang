.page { padding: 24rpx 32rpx 60rpx; min-height: 100vh; box-sizing: border-box; }
.compose-card { padding: 34rpx; }
.row-top { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; flex-wrap: wrap; }
.compose-title { font-size: 34rpx; font-weight: 700; }
.date-pick {
  color: var(--sub); font-size: 25rpx;
  background: var(--card2); border-radius: 999rpx; padding: 10rpx 24rpx;
}
.moods { display: flex; flex-wrap: wrap; gap: 16rpx; margin: 26rpx 0; }
.mood-pill {
  padding: 14rpx 28rpx; border-radius: 999rpx;
  border: 1rpx solid var(--border); font-size: 26rpx;
  background: var(--bg); transition: all 0.15s ease;
}
.mood-pill.on { background: var(--blue); border-color: var(--blue); color: #fff; }
.compose-text {
  width: 100%; min-height: 220rpx; box-sizing: border-box;
  background: var(--bg); border-radius: 24rpx;
  padding: 26rpx; font-size: 29rpx; line-height: 1.7;
}
.ph { color: var(--sub); }

.media-grid { display: flex; flex-wrap: wrap; gap: 18rpx; margin-top: 26rpx; }
.media-item {
  position: relative; width: 152rpx; height: 152rpx;
  border-radius: 20rpx; overflow: hidden; background: var(--card2);
}
.media-img { width: 100%; height: 100%; }
.media-play {
  position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 40rpx; background: rgba(0, 0, 0, 0.18);
}
.media-x {
  position: absolute; top: 6rpx; right: 6rpx;
  width: 40rpx; height: 40rpx; border-radius: 50%;
  background: rgba(0, 0, 0, 0.55); color: #fff;
  font-size: 22rpx; display: flex; align-items: center; justify-content: center;
}
.media-add {
  width: 152rpx; height: 152rpx; border-radius: 20rpx;
  border: 2rpx dashed var(--border); color: var(--sub);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  font-size: 40rpx; font-weight: 300;
}
.media-add text { font-size: 22rpx; margin-top: 2rpx; }

.save-btn { margin-top: 36rpx; width: 100%; border-radius: 999rpx; }
