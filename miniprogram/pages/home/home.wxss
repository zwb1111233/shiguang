.page { padding: 0 32rpx 60rpx; min-height: 100vh; box-sizing: border-box; }

/* Hero */
.hero { padding: 40rpx 4rpx 34rpx; }
.hero-eyebrow { color: var(--blue); font-size: 26rpx; font-weight: 600; margin-bottom: 14rpx; }
.hero-title { font-size: 64rpx; font-weight: 700; line-height: 1.18; letter-spacing: -1rpx; }
.hero-title .grad {
  background: linear-gradient(94deg, #0090f7, #a259ff 50%, #ff5e8a);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.hero-sub { color: var(--sub); font-size: 27rpx; margin-top: 16rpx; }
.hero-hint { color: var(--blue); }

/* 今日一言 */
.quote-card {
  position: relative; overflow: hidden;
  border-radius: 32rpx; padding: 34rpx 34rpx 38rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ff8a4c 0%, #ff5e8a 52%, #a960ff 100%);
  box-shadow: 0 10rpx 40rpx rgba(255, 94, 138, 0.28);
}
.quote-head { display: flex; justify-content: space-between; align-items: center; }
.badge-glass {
  padding: 8rpx 24rpx; border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2); font-size: 24rpx; font-weight: 500;
}
.btn-glass {
  padding: 8rpx 26rpx; border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18); font-size: 25rpx;
}
.quote-text {
  font-size: 36rpx; font-weight: 600; line-height: 1.5;
  margin: 30rpx 0 16rpx;
}
.quote-author { opacity: 0.85; font-size: 25rpx; }

/* 统计 */
.stat-row { display: flex; gap: 18rpx; margin-top: 20rpx; }
.stat-mini {
  flex: 1; background: var(--card); border-radius: 26rpx;
  box-shadow: var(--shadow); padding: 24rpx 26rpx;
  display: flex; flex-direction: column; gap: 6rpx;
}
.stat-num { font-size: 40rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.stat-label { color: var(--sub); font-size: 22rpx; }

/* 发布入口 */
.compose-cta {
  margin-top: 20rpx; display: flex; align-items: center; justify-content: space-between;
  padding: 32rpx 34rpx;
}
.cta-title { font-size: 32rpx; font-weight: 700; }
.cta-sub { color: var(--sub); font-size: 24rpx; margin-top: 4rpx; }
.cta-btn {
  width: 76rpx; height: 76rpx; border-radius: 50%;
  background: var(--blue); color: #fff; font-size: 44rpx; font-weight: 500;
  display: flex; align-items: center; justify-content: center;
}

/* 那年今天 */
.year-scroll { white-space: nowrap; }
.year-card { display: inline-block; width: 560rpx; margin-right: 20rpx; vertical-align: top; white-space: normal; }
.year-tag { color: var(--blue); font-size: 26rpx; font-weight: 700; margin-bottom: 14rpx; }
.td-item { margin-bottom: 16rpx; }
.td-meta { color: var(--sub); font-size: 23rpx; margin-bottom: 4rpx; }
.td-text {
  font-size: 26rpx; line-height: 1.55;
  display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
}

/* 瀑布流 */
.waterfall { display: flex; gap: 24rpx; }
.wf-col { flex: 1; display: flex; flex-direction: column; gap: 24rpx; }
.ecard { padding: 0; overflow: hidden; }
.ec-media { width: 100%; display: block; background: var(--card2); }
.ec-body { padding: 20rpx 24rpx 26rpx; }
.ec-meta { color: var(--sub); font-size: 23rpx; margin-bottom: 8rpx; }
.ec-text {
  font-size: 26rpx; line-height: 1.55; overflow-wrap: anywhere;
  display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
}

/* 历史上的今天 */
.hist-card { padding: 12rpx 30rpx; }
.hist-item {
  display: flex; gap: 24rpx; padding: 22rpx 0;
  border-bottom: 1rpx solid var(--border); align-items: baseline;
}
.hist-item:last-of-type { border-bottom: none; }
.hist-year { color: var(--blue); font-weight: 700; font-size: 30rpx; flex: none; width: 110rpx; }
.hist-text { font-size: 27rpx; line-height: 1.55; }
.hist-src { color: var(--sub); font-size: 21rpx; padding: 14rpx 0 16rpx; }
.hist-empty { color: var(--sub); text-align: center; padding: 40rpx 0; font-size: 26rpx; }

.page-foot { text-align: center; color: var(--sub); font-size: 23rpx; padding: 50rpx 0 20rpx; opacity: 0.8; }
