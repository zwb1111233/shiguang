<view class="theme-root {{tc}} page">
  <!-- 搜索 -->
  <view class="search-bar">
    <text class="search-ico">🔍</text>
    <input class="search-input" placeholder="搜索文字、标签……" placeholder-class="ph"
           bindinput="onSearchInput" confirm-type="search" />
  </view>

  <!-- 筛选 -->
  <view class="chips" wx:if="{{chips.length}}">
    <view class="chip chip-active" hover-class="press" wx:for="{{chips}}" wx:key="key"
          data-key="{{item.key}}" bindtap="clearChip">{{item.label}}</view>
  </view>
  <view class="count-row" wx:if="{{total}}">
    <text>共 {{total}} 条</text>
    <text wx:if="{{shown < total}}" class="count-more">上滑加载更多…</text>
  </view>

  <!-- 瀑布流 -->
  <view class="waterfall" wx:if="{{wf.left.length}}">
    <view class="wf-col">
      <view class="ecard card" hover-class="press" wx:for="{{wf.left}}" wx:key="id"
            data-id="{{item.id}}" bindtap="openDetail">
        <image wx:if="{{item.media.length}}" class="ec-media" src="{{item.media[0].path}}"
               mode="aspectFill" lazy-load style="height:{{item._mh}}rpx" />
        <view class="ec-body">
          <view class="ec-meta">{{item.moodEmoji ? item.moodEmoji + ' ' : ''}}{{item.dateText}}</view>
          <view class="ec-text" wx:if="{{item.text}}">{{item.text}}</view>
          <view class="ec-tags" wx:if="{{item.tags.length}}">
            <text class="ec-tag" wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this">#{{t}}</text>
          </view>
        </view>
      </view>
    </view>
    <view class="wf-col">
      <view class="ecard card" hover-class="press" wx:for="{{wf.right}}" wx:key="id"
            data-id="{{item.id}}" bindtap="openDetail">
        <image wx:if="{{item.media.length}}" class="ec-media" src="{{item.media[0].path}}"
               mode="aspectFill" lazy-load style="height:{{item._mh}}rpx" />
        <view class="ec-body">
          <view class="ec-meta">{{item.moodEmoji ? item.moodEmoji + ' ' : ''}}{{item.dateText}}</view>
          <view class="ec-text" wx:if="{{item.text}}">{{item.text}}</view>
          <view class="ec-tags" wx:if="{{item.tags.length}}">
            <text class="ec-tag" wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this">#{{t}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
  <view class="empty-tip" wx:if="{{!loading && !total}}">
    <text class="big">🍃</text>{{filter.q ? '没有找到相关记录' : '这里还空空的，去首页记录点什么吧'}}
  </view>

  <!-- 悬浮发布按钮 -->
  <view class="fab" hover-class="press" bindtap="goCompose">＋</view>
</view>
