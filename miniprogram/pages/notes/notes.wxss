.page { padding: 20rpx 32rpx 160rpx; min-height: 100vh; box-sizing: border-box; }

.search-bar {
  display: flex; align-items: center; gap: 14rpx;
  background: var(--card); border-radius: 999rpx;
  padding: 18rpx 30rpx; box-shadow: var(--shadow);
}
.search-ico { font-size: 28rpx; opacity: 0.6; }
.search-input { flex: 1; font-size: 28rpx; }
.ph { color: var(--sub); }

.chips { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 20rpx; }
.chip-active { background: var(--blue-soft); color: var(--blue); }

.count-row {
  display: flex; justify-content: space-between;
  color: var(--sub); font-size: 23rpx; margin: 18rpx 6rpx 4rpx;
}
.count-more { opacity: 0.8; }

.waterfall { display: flex; gap: 24rpx; margin-top: 16rpx; }
.wf-col { flex: 1; display: flex; flex-direction: column; gap: 24rpx; }
.ecard { padding: 0; overflow: hidden; }
.ec-media { width: 100%; display: block; background: var(--card2); }
.ec-body { padding: 20rpx 24rpx 26rpx; }
.ec-meta { color: var(--sub); font-size: 23rpx; margin-bottom: 8rpx; }
.ec-text {
  font-size: 26rpx; line-height: 1.55; overflow-wrap: anywhere;
  display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
}
.ec-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 10rpx; }
.ec-tag { color: var(--blue); font-size: 22rpx; }

.fab {
  position: fixed; right: 40rpx; bottom: 60rpx;
  width: 108rpx; height: 108rpx; border-radius: 50%;
  background: var(--blue); color: #fff;
  font-size: 56rpx; font-weight: 300;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 12rpx 36rpx rgba(0, 113, 227, 0.4);
  z-index: 10;
}
