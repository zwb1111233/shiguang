.lock-page {
  min-height: 100vh; display: flex; align-items: center; justify-content: center;
  padding: 40rpx; box-sizing: border-box; background: var(--bg);
}
.lock-card {
  width: 100%; max-width: 620rpx; text-align: center;
  background: var(--card); border-radius: 44rpx;
  box-shadow: var(--shadow); padding: 70rpx 56rpx 60rpx;
}
.lock-glyph {
  width: 110rpx; height: 110rpx; border-radius: 34rpx; margin: 0 auto 24rpx;
  background: linear-gradient(135deg, #0090f7, #a259ff 55%, #ff5e8a);
  display: flex; align-items: center; justify-content: center;
  font-size: 52rpx; color: #fff;
}
.lock-title { font-size: 40rpx; font-weight: 700; }
.lock-sub { color: var(--sub); font-size: 25rpx; margin: 12rpx 0 40rpx; }
.lock-input {
  background: var(--bg); border-radius: 24rpx;
  padding: 26rpx; font-size: 36rpx; letter-spacing: 8rpx;
  text-align: center; margin-bottom: 26rpx;
}
.lock-btn { width: 100%; }
